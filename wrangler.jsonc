{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interactec",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "interactec.bio",
      "custom_domain": true
    },
    {
      "pattern": "www.interactec.bio",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://interactec.bio"
  },
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "interactec-reports"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
